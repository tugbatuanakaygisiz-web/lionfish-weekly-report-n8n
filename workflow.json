      "id": "af1ff685-062b-4332-91f5-66d73a84e5bf",
      "name": "Read Log",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const total = $('GBIF Total').first().json;\nconst recent = $('GBIF Recent').first().json;\n\n// Earlier rows from the sheet (empty on the first run)\nconst rows = $input.all().map(i => i.json).filter(r => r.Total !== undefined && r.Total !== '');\nconst previous = rows.length ? Number(rows[rows.length - 1].Total) : null;\nconst diff = previous === null ? 0 : total.count - previous;\n\nconst names = { GR: 'Greece', TR: 'Türkiye', CY: 'Cyprus', IL: 'Israel', LB: 'Lebanon', SY: 'Syria', EG: 'Egypt', AL: 'Albania', IT: 'Italy', LY: 'Libya', HR: 'Croatia', ME: 'Montenegro' };\nconst facet = (total.facets || []).find(f => f.field === 'COUNTRY');\nconst countries = facet ? facet.counts.map(c => ({ name: names[c.name] || c.name, count: c.count })) : [];\n\nconst latest = (recent.results || [])\n  .filter(r => r.eventDate)\n  .sort((a, b) => String(b.eventDate).localeCompare(String(a.eventDate)))\n  .slice(0, 5);\n\nconst today = new Date().toISOString().slice(0, 10);\nconst diffText = previous === null ? 'First run – no earlier total to compare.' : (diff >= 0 ? '+' : '') + diff + ' since the last report (' + previous + ').';\n\nconst html =\n  '<h2>Lionfish Weekly Report – ' + today + '</h2>' +\n  '<p><b>Total records (Pterois miles, Eastern Mediterranean):</b> ' + total.count + '<br>' +\n  '<b>Change:</b> ' + diffText + '<br>' +\n  '<b>Observed in the last 30 days:</b> ' + recent.count + '</p>' +\n  '<h3>Records by country</h3><ul>' +\n  countries.map(c => '<li>' + c.name + ': ' + c.count + '</li>').join('') + '</ul>' +\n  '<h3>Latest observations</h3><ul>' +\n  (latest.length ? latest.map(r => '<li>' + String(r.eventDate).slice(0, 10) + ' – ' + (r.country || r.countryCode || '?') +\n    (r.stateProvince ? ', ' + r.stateProvince : '') +\n    ' – <a href=\"https://www.gbif.org/occurrence/' + r.key + '\">open record</a></li>').join('') : '<li>No new observations.</li>') +\n  '</ul><p style=\"color:#777\">Source: GBIF.org occurrence search. Built with n8n.</p>';\n\nreturn [{ json: {\n  Date: today,\n  Total: total.count,\n  Change: diff,\n  Last30Days: recent.count,\n  TopCountry: countries.length ? countries[0].name : '',\n  emailHtml: html\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
